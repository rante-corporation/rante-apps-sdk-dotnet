{
  "description": "manifest.json cases. CI checks them against the reference CLI (rante-apps-sdk packages/cli/lib/manifest.js and package.js) and the .NET tests against Rante.Apps.Packaging. A case starts from a base manifest (or a literal 'manifest'), applies 'set' (a null value removes the field), and expects exactly the sorted list of fields in 'fields' to be reported. Templates in strings: {s*N} is the text s repeated N times; {U+XXXX} is that character. 'raw' cases parse exact text (or hex bytes) and expect the error 'code', or none; 'bom' prefixes a byte order mark to a base manifest and expects the warning manifest_bom.",
  "base": {
    "bundle": {
      "manifestVersion": 1,
      "id": "3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c",
      "name": "Hello Rante",
      "version": "1.0.0",
      "hosting": "bundle",
      "entryPoint": "index.html",
      "icon": "icon.svg",
      "permissions": ["user.read", "tenant.read"]
    },
    "external": {
      "manifestVersion": 1,
      "id": "3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c",
      "name": "Contoso CRM",
      "version": "2.3.0",
      "hosting": "external",
      "entryPoint": "https://crm.contoso.example/rante",
      "icon": "https://crm.contoso.example/icon-128.png",
      "permissions": ["user.read", "tenant.read", "auth.token"]
    }
  },
  "cases": [
    { "name": "a bundle manifest", "base": "bundle", "fields": [] },
    { "name": "an external manifest", "base": "external", "fields": [] },
    {
      "name": "every optional field",
      "base": "bundle",
      "set": {
        "$schema": "https://example.com/schema.json",
        "description": "Line one.\nLine two.",
        "author": { "name": "Contoso Ltd", "email": "apps@contoso.example", "url": "https://contoso.example" },
        "permissions": ["user.read", "user.email", "tenant.read", "auth.token", "notifications", "navigation", "clipboard.write"],
        "connect": ["https://api.contoso.example", "wss://live.contoso.example:8443", "https://*.cdn.contoso.example"],
        "version": "10.20.30-beta.1"
      },
      "fields": []
    },
    { "name": "an empty object", "manifest": {}, "fields": ["hosting", "id", "manifestVersion", "name", "version"] },
    { "name": "null", "manifest": null, "fields": [""] },
    { "name": "an array", "manifest": [], "fields": [""] },
    { "name": "a typo", "base": "bundle", "set": { "permisions": [] }, "fields": ["permisions"] },
    { "name": "an unknown author field", "base": "bundle", "set": { "author": { "name": "A", "twitter": "@a" } }, "fields": ["author.twitter"] },
    { "name": "an author without a name", "base": "bundle", "set": { "author": { "email": "apps@contoso.example" } }, "fields": ["author.name"] },
    { "name": "a bad author email", "base": "bundle", "set": { "author": { "name": "A", "email": "not-an-email" } }, "fields": ["author.email"] },
    { "name": "an http author url", "base": "bundle", "set": { "author": { "name": "A", "url": "http://contoso.example" } }, "fields": ["author.url"] },
    { "name": "manifestVersion 2", "base": "bundle", "set": { "manifestVersion": 2 }, "fields": ["manifestVersion"] },
    { "name": "manifestVersion as text", "base": "bundle", "set": { "manifestVersion": "1" }, "fields": ["manifestVersion"] },
    { "name": "an id that is not a GUID", "base": "bundle", "set": { "id": "contoso.app" }, "fields": ["id"] },
    { "name": "the empty GUID", "base": "bundle", "set": { "id": "00000000-0000-0000-0000-000000000000" }, "fields": ["id"] },
    { "name": "an upper-case GUID", "base": "bundle", "set": { "id": "3F2B8C1E-7D4A-4E9B-A6C5-1D2E3F4A5B6C" }, "fields": [] },
    { "name": "version 0.0.1", "base": "bundle", "set": { "version": "0.0.1" }, "fields": [] },
    { "name": "version 1.2.3-rc.1", "base": "bundle", "set": { "version": "1.2.3-rc.1" }, "fields": [] },
    { "name": "version 1.2.3-0a", "base": "bundle", "set": { "version": "1.2.3-0a" }, "fields": [] },
    { "name": "version 1.2.3-x-y", "base": "bundle", "set": { "version": "1.2.3-x-y" }, "fields": [] },
    { "name": "version 1.0", "base": "bundle", "set": { "version": "1.0" }, "fields": ["version"] },
    { "name": "version v1.0.0", "base": "bundle", "set": { "version": "v1.0.0" }, "fields": ["version"] },
    { "name": "version 01.0.0", "base": "bundle", "set": { "version": "01.0.0" }, "fields": ["version"] },
    { "name": "version 1.0.0-01", "base": "bundle", "set": { "version": "1.0.0-01" }, "fields": ["version"] },
    { "name": "version 1.0.0+build", "base": "bundle", "set": { "version": "1.0.0+build" }, "fields": ["version"] },
    { "name": "version 1.0.0-", "base": "bundle", "set": { "version": "1.0.0-" }, "fields": ["version"] },
    { "name": "version 1.0.0-a..b", "base": "bundle", "set": { "version": "1.0.0-a..b" }, "fields": ["version"] },
    { "name": "version as a number", "base": "bundle", "set": { "version": 1 }, "fields": ["version"] },
    { "name": "no version", "base": "bundle", "set": { "version": null }, "fields": ["version"] },
    { "name": "an empty name", "base": "bundle", "set": { "name": "" }, "fields": ["name"] },
    { "name": "a padded name", "base": "bundle", "set": { "name": " Padded" }, "fields": ["name"] },
    { "name": "a 61-character name", "base": "bundle", "set": { "name": "{x*61}" }, "fields": ["name"] },
    { "name": "a 60-character name", "base": "bundle", "set": { "name": "{x*60}" }, "fields": [] },
    { "name": "a name with a bidi override", "base": "bundle", "set": { "name": "Bad{U+202E}name" }, "fields": ["name"] },
    { "name": "a name with a tab", "base": "bundle", "set": { "name": "Tab\tname" }, "fields": ["name"] },
    { "name": "a 501-character description", "base": "bundle", "set": { "description": "{x*501}" }, "fields": ["description"] },
    { "name": "a description with a zero-width space", "base": "bundle", "set": { "description": "a{U+200B}b" }, "fields": ["description"] },
    { "name": "hosting app", "base": "bundle", "set": { "hosting": "app" }, "fields": ["hosting"] },
    { "name": "entry point app/index.htm", "base": "bundle", "set": { "entryPoint": "app/index.htm" }, "fields": [] },
    { "name": "entry point ../index.html", "base": "bundle", "set": { "entryPoint": "../index.html" }, "fields": ["entryPoint"] },
    { "name": "entry point /index.html", "base": "bundle", "set": { "entryPoint": "/index.html" }, "fields": ["entryPoint"] },
    { "name": "entry point index.js", "base": "bundle", "set": { "entryPoint": "index.js" }, "fields": ["entryPoint"] },
    { "name": "entry point app/", "base": "bundle", "set": { "entryPoint": "app/" }, "fields": ["entryPoint"] },
    { "name": "entry point with a query", "base": "bundle", "set": { "entryPoint": "index.html?x=1" }, "fields": ["entryPoint"] },
    { "name": "a bundle entry point that is a URL", "base": "bundle", "set": { "entryPoint": "https://app.example.com/" }, "fields": ["entryPoint"] },
    { "name": "no entry point", "base": "bundle", "set": { "entryPoint": null }, "fields": ["entryPoint"] },
    { "name": "external entry point over http", "base": "external", "set": { "entryPoint": "http://app.example.com" }, "fields": ["entryPoint"] },
    { "name": "external entry point on localhost", "base": "external", "set": { "entryPoint": "https://localhost:3000" }, "fields": ["entryPoint"] },
    { "name": "external entry point on an IPv4 address", "base": "external", "set": { "entryPoint": "https://127.0.0.1/" }, "fields": ["entryPoint"] },
    { "name": "external entry point on an IPv6 address", "base": "external", "set": { "entryPoint": "https://[::1]/" }, "fields": ["entryPoint"] },
    { "name": "external entry point with credentials", "base": "external", "set": { "entryPoint": "https://user:pw@app.example.com" }, "fields": ["entryPoint"] },
    { "name": "external entry point with a fragment", "base": "external", "set": { "entryPoint": "https://app.example.com/#x" }, "fields": ["entryPoint"] },
    { "name": "external entry point on a bare host name", "base": "external", "set": { "entryPoint": "https://intranet/" }, "fields": ["entryPoint"] },
    { "name": "external entry point without a scheme", "base": "external", "set": { "entryPoint": "app.example.com" }, "fields": ["entryPoint"] },
    { "name": "external entry point with a space", "base": "external", "set": { "entryPoint": "https://a b.com" }, "fields": ["entryPoint"] },
    { "name": "external entry point with a port and a query", "base": "external", "set": { "entryPoint": "https://app.example.com:8443/rante?tenant=1" }, "fields": [] },
    { "name": "a gif icon", "base": "bundle", "set": { "icon": "icon.gif" }, "fields": ["icon"] },
    { "name": "a bundle icon that is a URL", "base": "bundle", "set": { "icon": "https://cdn.example.com/i.png" }, "fields": ["icon"] },
    { "name": "an external icon that is a file", "base": "external", "set": { "icon": "icon.png" }, "fields": ["icon"] },
    { "name": "an unknown permission", "base": "bundle", "set": { "permissions": ["user.read", "files.write"] }, "fields": ["permissions[1]"] },
    { "name": "a permission listed twice", "base": "bundle", "set": { "permissions": ["user.read", "user.read"] }, "fields": ["permissions[1]"] },
    { "name": "permissions as text", "base": "bundle", "set": { "permissions": "user.read" }, "fields": ["permissions"] },
    { "name": "connect with a path", "base": "bundle", "set": { "connect": ["https://api.example.com/path"] }, "fields": ["connect[0]"] },
    { "name": "connect over http", "base": "bundle", "set": { "connect": ["http://api.example.com"] }, "fields": ["connect[0]"] },
    { "name": "connect in upper case", "base": "bundle", "set": { "connect": ["https://API.example.com"] }, "fields": ["connect[0]"] },
    { "name": "connect to every .com", "base": "bundle", "set": { "connect": ["https://*.com"] }, "fields": ["connect[0]"] },
    { "name": "connect to localhost", "base": "bundle", "set": { "connect": ["https://localhost"] }, "fields": ["connect[0]"] },
    { "name": "connect to a .localhost name", "base": "bundle", "set": { "connect": ["https://dev.localhost"] }, "fields": ["connect[0]"] },
    { "name": "connect to port 0", "base": "bundle", "set": { "connect": ["https://api.example.com:0"] }, "fields": ["connect[0]"] },
    { "name": "connect to port 70000", "base": "bundle", "set": { "connect": ["https://api.example.com:70000"] }, "fields": ["connect[0]"] },
    { "name": "connect over ftp", "base": "bundle", "set": { "connect": ["ftp://x.example.com"] }, "fields": ["connect[0]"] },
    { "name": "connect to everything", "base": "bundle", "set": { "connect": ["*"] }, "fields": ["connect[0]"] },
    { "name": "connect listed twice", "base": "bundle", "set": { "connect": ["https://a.example.com", "https://a.example.com"] }, "fields": ["connect[1]"] },
    { "name": "connect on an external app", "base": "external", "set": { "connect": ["https://a.example.com"] }, "fields": ["connect"] },
    {
      "name": "21 connect origins",
      "base": "bundle",
      "set": {
        "connect": [
          "https://h0.example.com", "https://h1.example.com", "https://h2.example.com", "https://h3.example.com",
          "https://h4.example.com", "https://h5.example.com", "https://h6.example.com", "https://h7.example.com",
          "https://h8.example.com", "https://h9.example.com", "https://h10.example.com", "https://h11.example.com",
          "https://h12.example.com", "https://h13.example.com", "https://h14.example.com", "https://h15.example.com",
          "https://h16.example.com", "https://h17.example.com", "https://h18.example.com", "https://h19.example.com",
          "https://h20.example.com"
        ]
      },
      "fields": ["connect"]
    },
    { "name": "a $schema that is not text", "base": "bundle", "set": { "$schema": 1 }, "fields": ["$schema"] },
    { "name": "manifestVersion 1.0", "base": "bundle", "set": { "manifestVersion": 1.0 }, "fields": [] },
    { "name": "an id with a trailing newline", "base": "bundle", "set": { "id": "3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c{U+000A}" }, "fields": ["id"] },
    { "name": "a version with a trailing newline", "base": "bundle", "set": { "version": "1.0.0{U+000A}" }, "fields": ["version"] },
    { "name": "an author email with a trailing newline", "base": "bundle", "set": { "author": { "name": "A", "email": "apps@contoso.example{U+000A}" } }, "fields": ["author.email"] },
    { "name": "an author email with a byte order mark", "base": "bundle", "set": { "author": { "name": "A", "email": "apps{U+FEFF}@contoso.example" } }, "fields": ["author.email"] },
    { "name": "a bundle entry point with a trailing newline", "base": "bundle", "set": { "entryPoint": "index.html{U+000A}" }, "fields": ["entryPoint"] },
    { "name": "an external entry point with a byte order mark", "base": "external", "set": { "entryPoint": "https://app{U+FEFF}.example.com/" }, "fields": ["entryPoint"] },
    { "name": "connect with a trailing newline", "base": "bundle", "set": { "connect": ["https://api.example.com{U+000A}"] }, "fields": ["connect[0]"] }
  ],
  "raw": [
    { "name": "a repeated property", "text": "{\"name\":\"a\",\"name\":\"b\"}", "code": "manifest_invalid_json" },
    { "name": "a repeated nested property", "text": "{\"author\":{\"name\":\"a\",\"name\":\"b\"}}", "code": "manifest_invalid_json" },
    { "name": "cut-off JSON", "text": "{\"id\": ", "code": "manifest_invalid_json" },
    { "name": "a trailing comma", "text": "{\"a\":1,}", "code": "manifest_invalid_json" },
    { "name": "a comment", "text": "{/* x */}", "code": "manifest_invalid_json" },
    { "name": "single quotes", "text": "{'a':1}", "code": "manifest_invalid_json" },
    { "name": "data after the object", "text": "{} {}", "code": "manifest_invalid_json" },
    { "name": "invalid UTF-8", "hex": "7b226e616d65223a22ff227d", "code": "manifest_invalid_json" },
    { "name": "a byte order mark before a valid manifest", "bom": "bundle", "code": null }
  ]
}
